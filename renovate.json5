{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // JSON5 for the comments. The reasoning behind each rule is the expensive part to
  // reconstruct later, and docs/threat-model.md carries the policy this implements.
  //
  // Deliberately platform-agnostic: nothing GitHub-specific lives here except
  // `platformAutomerge`, which is a no-op elsewhere. The runner is
  // .github/workflows/renovate.yml — one file to replace if this ever moves off GitHub.

  extends: [
    'config:recommended',
    ':maintainLockFilesWeekly',
  ],

  // Deliberately NOT config:best-practices, which the sibling repo uses. It brings
  // `helpers:pinGitHubActionDigests` and `docker:pinDigests`. Digest pinning on
  // node:26.7.0-trixie-slim would open a PR every time the official image rebuilds, which is
  // the loudest possible setting on a repo this size.
  //
  // This used to also be about the token: pinning rewrites .github/workflows/, and Workflows
  // write was treated as a grant to avoid. That was never achievable — any Action version bump
  // edits a workflow file, pinned or not — so the token has it anyway. See docs/threat-model.md.

  timezone: 'Europe/Berlin',

  // All of Monday, not Monday morning. GitHub starts scheduled workflows late — the 07:00
  // Berlin trigger in renovate.yml has begun anywhere from 07:38 to 13:24 — and a run that
  // lands outside the window looks at everything and pushes nothing. The old `2-8` window was
  // missed three Mondays running (2026-08-31 to 2026-09-14); updates only got through because
  // their dashboard boxes had been ticked by hand. The weekly cron is the real rate limit.
  schedule: ['* * * * 1'],

  // `:maintainLockFilesWeekly` brings its own schedule — `schedule:weekly`, which is before
  // 4 AM on Monday — so it would be missed by a late run exactly as above. Same window.
  lockFileMaintenance: {
    schedule: ['* * * * 1'],
  },

  // Seven dependencies behind a weekly schedule is not much traffic; the schedule is
  // already the rate limit, so the hourly one only gets in the way.
  prConcurrentLimit: 3,
  prHourlyLimit: 0,

  packageRules: [
    {
      // ── The supply-chain floor ──────────────────────────────────────────────────────
      //
      // Nothing is proposed until it has been public for two weeks. Malicious npm releases
      // are typically yanked within days of discovery, so the wait is what makes unattended
      // automerge defensible at all — this repo publishes a container image, so a
      // compromised dependency gets built into something that ships.
      //
      // Must come first and match everything: a later rule wins over an earlier one.
      //
      // Note `minimumReleaseAgeBehaviour` defaults to 'timestamp-required' since Renovate
      // 42, so a datasource without release timestamps would freeze rather than sail
      // through. Everything here (npm, nodejs.org, Docker Hub, GitHub releases) publishes
      // timestamps, so nothing stalls.
      matchPackageNames: ['*'],
      minimumReleaseAge: '14 days',
    },

    {
      // ── One batched PR for everything non-major, automerged ─────────────────────────
      //
      // Seven caret-ranged dependencies would otherwise trickle in as seven separate PRs.
      // Automerge is safe here because the gate is real: `test` runs the suite, and
      // `docker` builds the image, boots the container and curls it. A Fastify patch that
      // breaks plugin registration fails that smoke test rather than reaching main.
      matchManagers: ['npm', 'github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest', 'lockFileMaintenance'],
      // Insurance rather than a filter today — all seven deps are >=1.0.0, but on 0.x a
      // minor is allowed to break.
      matchCurrentVersion: '!/^0/',
      groupName: 'all non-major dependencies',
      automerge: true,
    },

    {
      // ── The runner is not a dependency ──────────────────────────────────────────────
      //
      // Renovate's github-runners datasource reads `runs-on: ubuntu-latest` and offers to
      // pin it to a numbered release. `ubuntu-latest` is deliberate here: this project has
      // no runner-specific requirements, and tracking whatever GitHub currently ships is
      // the point of the alias. Found by the extraction dry-run, which is the only way it
      // would have surfaced before the first PR.
      matchDatasources: ['github-runners'],
      enabled: false,
    },

    {
      // ── Majors are never automatic ──────────────────────────────────────────────────
      // Read the changelog, then merge. One at a time.
      matchUpdateTypes: ['major'],
      automerge: false,
    },

    {
      // ── Node moves as one thing ─────────────────────────────────────────────────────
      //
      // Pinned in four machine-readable places that must agree: .nvmrc, package.json
      // `engines`, `node-version` in ci.yml, and the Dockerfile's FROM tag. Ungrouped,
      // one Node release means four PRs, each of which leaves the repo disagreeing with
      // itself until the last lands.
      //
      // `group:nodeJs` from config:recommended is NOT enough: it matches only the `docker`
      // and `node-version` datasources, and `node-version:` in a workflow extracts under
      // `github-releases`, so setup-node would fall outside the group. It also sets no
      // groupName. Hence the explicit rule.
      //
      // Never automerged: a Node major also needs the README badge and prose changed, and
      // Renovate cannot do that.
      //
      // `engines: '>=26'` is expected NOT to move — 27 still satisfies it, so the default
      // range strategy leaves it alone. That is intended: the floor is a support promise
      // and should move when Node 26 is consciously dropped, not automatically.
      groupName: 'Node.js',
      matchDepNames: ['node'],
      matchManagers: ['npm', 'nvm', 'dockerfile', 'github-actions'],
      automerge: false,
    },
  ],

  // Security fixes skip the queue by default — `minimumReleaseAge: null`, `schedule` and
  // the PR limits are all bypassed for vulnerability alerts without being restated here.
  // Only the parts that differ from the default belong in this block.
  //
  // Reads GitHub's Dependabot alerts, so Dependency graph and Dependabot alerts must be
  // enabled on the repository or this silently does nothing.
  vulnerabilityAlerts: {
    labels: ['security'],
    automerge: true,
  },

  // Direct dependencies only, and worth having for more than the CVEs: OSV data lets
  // Renovate recognise a package that has been taken over and refuse to propose updates
  // to it at all, rather than dutifully bumping into the malicious release.
  osvVulnerabilityAlerts: true,
}
