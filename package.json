{
  "name": "wikidata-inat-checker",
  "version": "1.0.0",
  "description": "Finds iNaturalist observations with Commons-compatible licenses for Wikidata taxon items that lack an image, and generates draft Wikimedia Commons category pages for them",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "check-images": "checkImages.js",
    "check-names": "checkNames.js",
    "check-links": "checkLinks.js",
    "check-area": "checkArea.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "images": "node checkImages.js",
    "names": "node checkNames.js",
    "links": "node checkLinks.js",
    "area": "node checkArea.js"
  },
  "keywords": [
    "wikidata",
    "wikimedia-commons",
    "inaturalist",
    "biodiversity",
    "taxonomy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Livia-Rasp/wikidata-inat-checker.git"
  },
  "author": "Livia Rasp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Livia-Rasp/wikidata-inat-checker/issues"
  },
  "homepage": "https://github.com/Livia-Rasp/wikidata-inat-checker#readme",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "p-limit": "^7.3.0",
    "wikibase-sdk": "^11.6.1"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true
  }
}
