{
  "name": "wikidata-inat-checker",
  "version": "1.0.0",
  "description": "Finds gaps in Wikidata's taxon items — missing images, vernacular names and iNaturalist links — by reconciling a local SQLite index of iNaturalist's 1.4M-taxon dump against Wikidata over batched SPARQL, with an assisted iNaturalist-to-Wikimedia-Commons photo upload app",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "check-images": "checkImages.js",
    "verify-findings": "verifyFindings.js",
    "check-names": "checkNames.js",
    "check-links": "checkLinks.js",
    "check-links-stats": "checkLinksStats.js",
    "check-area": "checkArea.js",
    "draft-category": "draftCategory.js"
  },
  "scripts": {
    "test": "node --test",
    "images": "node checkImages.js",
    "verify": "node verifyFindings.js",
    "names": "node checkNames.js",
    "links": "node checkLinks.js",
    "linkStats": "node checkLinksStats.js",
    "area": "node checkArea.js",
    "draft": "node draftCategory.js",
    "web": "node server/index.js",
    "screenshots": "node tools/screenshots.mjs"
  },
  "keywords": [
    "wikidata",
    "wikimedia-commons",
    "inaturalist",
    "biodiversity",
    "taxonomy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Livia-Rasp/wikidata-inat-checker.git"
  },
  "author": "Livia Rasp",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Livia-Rasp/wikidata-inat-checker/issues"
  },
  "homepage": "https://github.com/Livia-Rasp/wikidata-inat-checker#readme",
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "p-limit": "^7.3.0",
    "wikibase-sdk": "^11.6.1"
  }
}
