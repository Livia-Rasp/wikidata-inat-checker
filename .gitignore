# Dependencies
node_modules/

# Generated deliverables (HTML reports, QuickStatements, JSON exports)
output/
# Cross-run caches (skip already-checked taxa)
cache/
# Findings database — durable state, NOT regenerable. Back it up; don't just delete it.
data/
# VACUUM INTO snapshots of data/ (tools/backup.mjs) — disposable, unlike data/ itself
backups/

# Logs and diagnostics. logs/.gitkeep stays tracked (nothing above ignores the directory itself,
# only *.log within it) so the directory pre-exists in a fresh checkout — a bind mount to a
# directory that doesn't exist yet gets auto-created by the Docker daemon as root, which the
# container's unprivileged node user then can't write to. See docs/logging.md.
*.log
npm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Environment and local tool settings
.env
.env.test
.claude/settings.local.json

# Editor / OS noise
.DS_Store
*.tgz
