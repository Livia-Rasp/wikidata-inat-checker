# Copy to .env (gitignored) on a host that serves the app to the LAN. See docs/deployment.md.
#
# Docker Compose reads .env from the directory compose.yaml is in and substitutes these into it.
# Local development needs none of this: with no .env, compose.yaml binds loopback only and
# discovery is off. Nothing here is a secret — the one secret is MCP_AUTH_TOKEN, in mcp-server/.env.

# Which host address the app's port is published on. 127.0.0.1 (the default) keeps it off the
# network. 0.0.0.0 serves every interface, as the gallery's port does. One LAN address is
# tighter, but the container then fails to start at boot if Docker comes up before that address
# is assigned.
WINC_BIND=0.0.0.0

# Every name and address a browser will use to reach this host, comma-separated, no port: its
# name on the network, its short name if that resolves too, and its address. The write guard
# refuses any write whose Host header is not listed (`host_not_allowed`). Must be filled in.
WINC_ALLOWED_HOSTS=

# The container runs as whoever owns ./data. Only needed if `id -u` is not 1000.
#WINC_UID=1000
#WINC_GID=1000

# Rolling back: pin a version or commit-sha tag from GHCR. Watchtower stops updating the container
# until this line is removed again.
#WINC_TAG=1.10.0

# "Find more" and the area page. Needs the taxa index, which the first
# `docker compose run --rm cli checkImages.js …` builds.
DISCOVER_ENABLED=1

# One scheduled discovery a day per kind (images, links, names), in a quiet hour. Requires
# DISCOVER_ENABLED. With no scope it walks the whole iNat index; a scope keeps it cheap:
TOPUP_ENABLED=1
TOPUP_IUCN=CR
#TOPUP_TAXON=Orchidaceae
#TOPUP_LIMIT=500
