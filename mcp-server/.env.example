# Copy to mcp-server/.env (gitignored) before starting the server.

# Shared secret every MCP client must present as `Authorization: Bearer <token>`.
# Required — the server refuses to start without it, rather than listening on
# the LAN unauthenticated. Generate one with:
#   openssl rand -hex 32
# Deliberately env-only, never a --flag: command-line arguments are visible to
# every user on the box via `ps`.
MCP_AUTH_TOKEN=

# Directory holding the app's rotated NDJSON logs. Inside the container this is
# the read-only mount from compose.yaml (../logs:/logs:ro); locally it's ../logs.
# `--logs <dir>` on the command line wins over this.
LOG_DIR=/logs

# Port to listen on (default 3400 — see the vault's Ports.md registry).
PORT=3400

# Interface to bind. 0.0.0.0 is required for the cross-PC case (a container
# port publish, or another machine on the LAN); use 127.0.0.1 to keep it
# local-only. See ALLOWED_HOSTS below — binding wide without that is what the
# MCP spec's DNS-rebinding guidance warns about.
BIND_HOST=0.0.0.0

# Comma-separated Host header allowlist (no port). Any request whose Host is
# not on this list gets 403, which is what stops a browser on the LAN being
# used as a confused deputy against this port. Add the server's LAN name and
# address here, e.g.:
#   ALLOWED_HOSTS=localhost,127.0.0.1,[::1],server-pc.fritz.box,192.168.178.42
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
